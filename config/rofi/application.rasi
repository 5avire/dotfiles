configuration {
    modi: "drun,run,filebrowser,window";
    show-icons: true;
    drun-display-format: "{name}";
    window-format: "{w} · {c} · {t}";
}

* {
    font: "JetBrains Mono Nerd 14";
    background: #1a1a1e;
    foreground: #e0f0ff;
    selected: rgba(205,214,244,0.20);
    active: #cdd6f4;
    urgent: #8D0083;
    border: #cdd6f4;
}

window {
    border-color: @border;
    border: 4px;
    border-radius: 2px;
    location: center;
    anchor: center;
    fullscreen: false;
    height: 40%;
    width: 40%;
    background-color: @background;
    padding: 0px;
}

mainbox {
    orientation: horizontal;
    children: [ "imagebox", "listbox" ];
}

imagebox {
    width: 35%;
    background-color: transparent;
    background-image: url("/home/savvy/dots/wallpapers/rofi-bg", height);
    children: [ "dummy" ];
}

dummy {
    background-color: transparent;
}

listbox {
    children: [ "inputbar", "message", "listview" ];
}

inputbar {
    spacing: 0px;
    padding: 15px;
    background-color: transparent;
    text-color: @foreground;
    children: [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    str: "";
}

entry {
    placeholder: "";
}

listview {
    scrollbar: false;
    spacing: 10px;
    layout: vertical;
    background-color: transparent;
    text-color: @foreground;
    border: 0px;
    padding: 10px;
}

element {
    padding: 12px;
    background-color: transparent;
    text-color: @foreground;
    cursor: pointer;
}

element selected.normal {
    background-color: @selected;
    text-color: @foreground;
}

element-icon {
    size: 24px;
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
    margin: 0 15px 0 10px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

textbox {
    padding: 10px;
    background-color: @background;
    text-color: @foreground;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

element.alternate.normal {
    background-color: @background;
}
